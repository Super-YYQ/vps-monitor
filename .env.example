# Initial admin password. Only used when the database is first created.
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# Default access through localhost / SSH tunnel. Use a domain for public HTTPS.
BIND_ADDRESS=127.0.0.1
PORT=8080
SECURE_COOKIES=false
APP_ORIGIN=
# For automatic HTTPS: bash deploy.sh --domain radar.example.com
DOMAIN=
